# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
PROXY_API_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Must belong to a Free-plan Groq organization. The gateway cannot change/check the plan.
GROQ_API_KEY=CHANGE_ME_GROQ_KEY
# Google Cloud Text-to-Speech project (not a Gemini / AI Studio API key).
GOOGLE_CLOUD_PROJECT=CHANGE_ME_PROJECT_ID
GOOGLE_TTS_VOICE=ko-KR-Wavenet-A
ASR_DEFAULT_LANGUAGE=ko
# Conservative local reservations; no refunds on failed upstream requests.
TTS_ROLLING_32D_CHAR_LIMIT=3500000
TTS_ROLLING_24H_CHAR_LIMIT=150000
# 0 disables the in-memory TTS audio cache. No audio is stored in the usage DB.
TTS_CACHE_MAX_BYTES=16777216
TTS_CACHE_TTL_SECONDS=3600
MAX_CONCURRENT_REQUESTS=2
# Docker publishes to loopback by default. For Tailscale, set the host's 100.x address.
BIND_IP=127.0.0.1
PORT=8787
# Local Python launch uses this; Compose explicitly sets its own in-container paths.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-adc.json
DATA_DIR=./data
