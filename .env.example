# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
PROXY_API_KEY=
GROQ_API_KEY=
# Set true ONLY after checking the Groq key belongs to a Free-plan organization.
GROQ_FREE_TIER_CONFIRMED=false
GROQ_MODEL=whisper-large-v3-turbo
ASR_DEFAULT_LANGUAGE=ko

# Google Cloud TTS uses ADC, not a Gemini / AI Studio API key.
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=secrets/google-adc.json
GOOGLE_TTS_VOICE=ko-KR-Wavenet-A

BIND_IP=127.0.0.1
PORT=8787
USAGE_DB_PATH=data/usage.sqlite3

# Conservative local limits; these do not cover other applications' usage.
# Setting a quota to 0 blocks that provider; it does not disable the guard.
TTS_32DAY_CHAR_LIMIT=3500000
TTS_DAILY_CHAR_LIMIT=150000
GROQ_MINUTE_REQUEST_LIMIT=20
GROQ_DAILY_REQUEST_LIMIT=2000
GROQ_HOURLY_AUDIO_SECONDS_LIMIT=7200
GROQ_DAILY_AUDIO_SECONDS_LIMIT=28800
MAX_AUDIO_SECONDS=600
MAX_UPLOAD_BYTES=25000000
MAX_TTS_INPUT_CHARS=20000
MAX_OUTPUT_AUDIO_BYTES=67108864
UPSTREAM_TIMEOUT_SECONDS=60
REQUEST_TIMEOUT_SECONDS=300
FFMPEG_TIMEOUT_SECONDS=30
MAX_CONCURRENT_REQUESTS=4
CACHE_MAX_BYTES=33554432
CACHE_TTL_SECONDS=3600
